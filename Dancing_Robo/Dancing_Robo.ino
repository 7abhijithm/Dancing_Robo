// Rest position
void restPosition() {
  leftHip.write(90);
  rightHip.write(90);
  leftFoot.write(90);
  rightFoot.write(90);
}

// Dance moves: choose a different random pose each time.
// Angles stay within 60-120 degrees to reduce mechanical strain.
void dance() {
  static int previousMove = -1;
  int move = random(0, 48);

  // Prevent the same pose from repeating back-to-back.
  if (move == previousMove) {
    move = (move + random(1, 48)) % 24;
  }
  previousMove = move;

  switch (move) {
    // Alternating hip swings
    case 0:  leftHip.write(65);  rightHip.write(115); leftFoot.write(90);  rightFoot.write(90);  break;
    case 1:  leftHip.write(115); rightHip.write(65);  leftFoot.write(90);  rightFoot.write(90);  break;

    // Alternating foot taps
    case 2:  leftHip.write(90); rightHip.write(90); leftFoot.write(65);  rightFoot.write(115); break;
    case 3:  leftHip.write(90); rightHip.write(90); leftFoot.write(115); rightFoot.write(65);  break;

    // Coordinated diagonal steps
    case 4:  leftHip.write(70);  rightHip.write(110); leftFoot.write(70);  rightFoot.write(110); break;
    case 5:  leftHip.write(110); rightHip.write(70);  leftFoot.write(110); rightFoot.write(70);  break;
    case 6:  leftHip.write(80);  rightHip.write(100); leftFoot.write(105); rightFoot.write(75);  break;
    case 7:  leftHip.write(100); rightHip.write(80);  leftFoot.write(75);  rightFoot.write(105); break;

    // Side-to-side groove
    case 8:  leftHip.write(70);  rightHip.write(110); leftFoot.write(80);  rightFoot.write(100); break;
    case 9:  leftHip.write(110); rightHip.write(70);  leftFoot.write(100); rightFoot.write(80);  break;

    // Heel/toe taps
    case 10: leftHip.write(90); rightHip.write(90); leftFoot.write(60);  rightFoot.write(100); break;
    case 11: leftHip.write(90); rightHip.write(90); leftFoot.write(100); rightFoot.write(60);  break;

    // Hip twist with counter-step
    case 12: leftHip.write(60);  rightHip.write(120); leftFoot.write(105); rightFoot.write(75);  break;
    case 13: leftHip.write(120); rightHip.write(60);  leftFoot.write(75);  rightFoot.write(105); break;

    // Double bounce
    case 14: leftHip.write(75);  rightHip.write(105); leftFoot.write(75);  rightFoot.write(105); break;
    case 15: leftHip.write(105); rightHip.write(75);  leftFoot.write(105); rightFoot.write(75);  break;

    // New: cross-step variations
    case 16: leftHip.write(65);  rightHip.write(105); leftFoot.write(115); rightFoot.write(85);  break;
    case 17: leftHip.write(105); rightHip.write(65);  leftFoot.write(85);  rightFoot.write(115); break;

    // New: alternating diagonal kicks
    case 18: leftHip.write(80);  rightHip.write(115); leftFoot.write(60);  rightFoot.write(100); break;
    case 19: leftHip.write(115); rightHip.write(80);  leftFoot.write(100); rightFoot.write(60);  break;

    // New: open-and-close pose
    case 20: leftHip.write(60);  rightHip.write(120); leftFoot.write(60);  rightFoot.write(120); break;
    case 21: leftHip.write(120); rightHip.write(60);  leftFoot.write(120); rightFoot.write(60);  break;

    // New: asymmetrical groove
    case 22: leftHip.write(75);  rightHip.write(115); leftFoot.write(95);  rightFoot.write(65);  break;
    case 23: leftHip.write(115); rightHip.write(75);  leftFoot.write(65);  rightFoot.write(95);  break;
    // Additional 24 choreography poses
    case 24: leftHip.write(68);  rightHip.write(112); leftFoot.write(68);  rightFoot.write(92);  break;
    case 25: leftHip.write(112); rightHip.write(68);  leftFoot.write(92);  rightFoot.write(68);  break;
    case 26: leftHip.write(82);  rightHip.write(118); leftFoot.write(108); rightFoot.write(82);  break;
    case 27: leftHip.write(118); rightHip.write(82);  leftFoot.write(82);  rightFoot.write(108); break;
    case 28: leftHip.write(72);  rightHip.write(98);  leftFoot.write(118); rightFoot.write(88);  break;
    case 29: leftHip.write(98);  rightHip.write(72);  leftFoot.write(88);  rightFoot.write(118); break;
    case 30: leftHip.write(62);  rightHip.write(108); leftFoot.write(98);  rightFoot.write(72);  break;
    case 31: leftHip.write(108); rightHip.write(62);  leftFoot.write(72);  rightFoot.write(98);  break;
    case 32: leftHip.write(78);  rightHip.write(108); leftFoot.write(62);  rightFoot.write(112); break;
    case 33: leftHip.write(108); rightHip.write(78);  leftFoot.write(112); rightFoot.write(62);  break;
    case 34: leftHip.write(88);  rightHip.write(112); leftFoot.write(72);  rightFoot.write(102); break;
    case 35: leftHip.write(112); rightHip.write(88);  leftFoot.write(102); rightFoot.write(72);  break;
    case 36: leftHip.write(62);  rightHip.write(118); leftFoot.write(82);  rightFoot.write(98);  break;
    case 37: leftHip.write(118); rightHip.write(62);  leftFoot.write(98);  rightFoot.write(82);  break;
    case 38: leftHip.write(78);  rightHip.write(118); leftFoot.write(118); rightFoot.write(78);  break;
    case 39: leftHip.write(118); rightHip.write(78);  leftFoot.write(78);  rightFoot.write(118); break;
    case 40: leftHip.write(68);  rightHip.write(92);  leftFoot.write(112); rightFoot.write(102); break;
    case 41: leftHip.write(92);  rightHip.write(68);  leftFoot.write(102); rightFoot.write(112); break;
    case 42: leftHip.write(82);  rightHip.write(102); leftFoot.write(62);  rightFoot.write(92);  break;
    case 43: leftHip.write(102); rightHip.write(82);  leftFoot.write(92);  rightFoot.write(62);  break;
    case 44: leftHip.write(62);  rightHip.write(98);  leftFoot.write(118); rightFoot.write(102); break;
    case 45: leftHip.write(98);  rightHip.write(62);  leftFoot.write(102); rightFoot.write(118); break;
    case 46: leftHip.write(72);  rightHip.write(118); leftFoot.write(92);  rightFoot.write(62);  break;
    case 47: leftHip.write(118); rightHip.write(72);  leftFoot.write(62);  rightFoot.write(92);  break;
  }

  danceStep++;
}

// OLED sound wave animation
void showWave() {

  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(25, 0);
  display.println("ROBOT DANCING!");

  // Sound level bar
  display.drawRect(5, 12, 118, 9, SSD1306_WHITE);

  int barWidth = map(
    constrain(soundLevel, SOUND_THRESHOLD, 4095),
    SOUND_THRESHOLD, 4095,
    0, 114
  );

  display.fillRect(7, 14, barWidth, 5, SSD1306_WHITE);

  // Animated sound waves
  for (int i = 0; i < 16; i++) {

    int x = 5 + i * 8;

    int height = random(5, 35);

    // Stronger sound = taller waves
    height = map(
      constrain(soundLevel, SOUND_THRESHOLD, 4095),
      SOUND_THRESHOLD, 4095,
      5, height
    );

    int y = 60 - height;

    display.drawLine(
      x, 60,
      x, y,
      SSD1306_WHITE
    );
  }

  display.display();

  waveOffset++;
}

// Display the supplied animated robot eyes. Frame updates are non-blocking.
void showIdleEyes() {
  unsigned long now = millis();

  if (now - lastEyeFrameTime >= FRAME_MS) {
    lastEyeFrameTime = now;

    const unsigned char* frame =
      (const unsigned char*)pgm_read_ptr(&FRAMES[eyeFrame]);

    display.clearDisplay();
    display.drawBitmap(
      0, 0, frame,
      SCREEN_WIDTH, SCREEN_HEIGHT,
      SSD1306_WHITE
    );
    display.display();

    eyeFrame++;
    if (eyeFrame >= FRAME_COUNT) {
      eyeFrame = 0;
    }
  }
}


// Select a random animation clip. Avoid choosing the same clip twice in a row.
void chooseRandomDanceClip() {
  uint8_t nextClip = random(0, 3);
  if (previousDanceClip >= 0 && nextClip == (uint8_t)previousDanceClip) {
    nextClip = (nextClip + random(1, 3)) % 3;
  }

  activeDanceClip = nextClip;
  previousDanceClip = nextClip;
  activeDanceFrame = 0;
  lastDanceAnimationFrame = millis();
}

uint16_t danceClipFrameCount() {
  // Keep each animation at its original stored frame count.
  switch (activeDanceClip) {
    case 0: return CLIP_A_COUNT;
    case 1: return CLIP_B_COUNT;
    default: return CLIP_C_COUNT;
  }
}

// Keep the original playback interval for each source animation.
unsigned long danceClipFrameInterval() {
  return (activeDanceClip == 1) ? 167UL : 67UL;
}

const uint8_t* getDanceAnimationFrame(uint16_t frameIndex) {
  switch (activeDanceClip) {
    case 0:
      return (const uint8_t*)pgm_read_ptr(&clipA_frames[frameIndex]);
    case 1:
      return (const uint8_t*)pgm_read_ptr(&clipB_frames[frameIndex]);
    default:
      return (const uint8_t*)pgm_read_ptr(&clipC_frames[frameIndex]);
  }
}

void startRandomDanceAnimation() {
  chooseRandomDanceClip();
  danceClipStartedAt = millis();
  Serial.print("OLED dance animation selected: clip ");
  Serial.println(activeDanceClip + 1);
}

// Rotate through randomly chosen clips continuously while music is detected.
// Each source clip has 3x virtual frames with dithered transition frames.
void showRandomDanceAnimation() {
  unsigned long now = millis();

  if (now - danceClipStartedAt >= DANCE_CLIP_SEGMENT_MS) {
    chooseRandomDanceClip();
    danceClipStartedAt = now;
  }

  if (now - lastDanceAnimationFrame < danceClipFrameInterval()) return;
  lastDanceAnimationFrame = now;

  const uint8_t* frame = getDanceAnimationFrame(activeDanceFrame);
  display.clearDisplay();
  display.drawBitmap(0, 0, frame, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
  display.display();

  activeDanceFrame++;
  if (activeDanceFrame >= danceClipFrameCount()) {
    chooseRandomDanceClip();
    danceClipStartedAt = now;
  }
}

void setup() {

  Serial.begin(115200);

  // OLED setup
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(
    SSD1306_SWITCHCAPVCC, 0x3C
  )) {
    Serial.println("OLED ERROR!");
    while (1);
  }

  // Servo setup
  leftHip.setPeriodHertz(50);
  rightHip.setPeriodHertz(50);
  leftFoot.setPeriodHertz(50);
  rightFoot.setPeriodHertz(50);

  leftHip.attach(LEFT_HIP, 500, 2400);
  rightHip.attach(RIGHT_HIP, 500, 2400);
  leftFoot.attach(LEFT_FOOT, 500, 2400);
  rightFoot.attach(RIGHT_FOOT, 500, 2400);

  restPosition();

  analogReadResolution(12);

  randomSeed((uint32_t)analogRead(MIC_PIN) ^ micros());

  display.clearDisplay();
  display.display();

  startupIdleStartedAt = millis();
  lastEyeFrameTime = startupIdleStartedAt - FRAME_MS; // first idle-eye frame immediately

  Serial.println("DANCE ROBOT: 15-second startup idle; listening for music.");
}

void loop() {
  unsigned long now = millis();
  bool sampleMicrophone = true;

  // While dancing, use a 300 ms movement phase followed by a 200 ms
  // listen phase. Do not read the MAX9814 during the movement phase.
  if (dancing) {
    unsigned long cycleElapsed = now - lastDanceTime;

    if (cycleElapsed >= DANCE_CYCLE_MS) {
      dance();
      lastDanceTime = now;
      listenSampleTaken = false;
      cycleElapsed = 0;
    }

    if (cycleElapsed < SERVO_MOVE_PHASE_MS) {
      sampleMicrophone = false;
    } else if (cycleElapsed < DANCE_CYCLE_MS) {
      // One 20 ms microphone sample per listen phase, not every loop.
      sampleMicrophone = !listenSampleTaken;
    } else {
      sampleMicrophone = false;
    }
  }

  bool validSoundSample = false;
  if (sampleMicrophone) {
    int micMin = 4095;
    int micMax = 0;
    unsigned long sampleStart = millis();

    while (millis() - sampleStart < 20UL) {
      int sample = analogRead(MIC_PIN);
      if (sample < micMin) micMin = sample;
      if (sample > micMax) micMax = sample;
    }

    soundLevel = micMax - micMin;
    now = millis();
    validSoundSample = true;

    if (dancing) {
      listenSampleTaken = true;
    }

    // Diagnostic output only for actual microphone samples.
    static unsigned long lastSoundPrint = 0;
    if (now - lastSoundPrint >= 500UL) {
      Serial.print("Sound level: ");
      Serial.print(soundLevel);
      Serial.print(" | musicDetected: ");
      Serial.println(musicDetected ? "YES" : "NO");
      lastSoundPrint = now;
    }
  }

  // Update the music state only from valid microphone samples.
  // Servo movement noise is therefore excluded from the detector.
  if (validSoundSample) {
    if (!musicDetected) {
      quietStartedAt = 0;

      if (soundLevel >= MUSIC_START_THRESHOLD) {
        if (musicConfirmCount < MUSIC_CONFIRM_WINDOWS) {
          musicConfirmCount++;
        }

        if (musicConfirmCount >= MUSIC_CONFIRM_WINDOWS) {
          musicDetected = true;
          musicConfirmCount = 0;
          quietStartedAt = 0;
          Serial.println("Music detected - dance enabled.");
        }
      } else {
        musicConfirmCount = 0;
      }
    } else {
      if (soundLevel < MUSIC_STOP_THRESHOLD) {
        if (quietStartedAt == 0) {
          quietStartedAt = now;
        }

        if (now - quietStartedAt >= SILENCE_TIMEOUT_MS) {
          musicDetected = false;
          quietStartedAt = 0;
          musicConfirmCount = 0;
          Serial.println("Quiet for 1.2 seconds - dance disabled.");
        }
      } else {
        quietStartedAt = 0;
      }
    }
  }

  bool startupIdleFinished =
      (now - startupIdleStartedAt >= STARTUP_IDLE_MS);

  // Mandatory first 15 seconds: idle pose and idle animation only.
  if (!startupIdleFinished) {
    dancing = false;
    restPosition();
    showIdleEyes();
  }
  // Dance only while music is detected.
  else if (musicDetected) {
    if (!dancing) {
      dancing = true;
      danceStep = 0;
      lastDanceTime = now;
      listenSampleTaken = false;
      dance(); // First pose immediately; microphone remains off during move.
      startRandomDanceAnimation();
      Serial.println("Music active - dancing (300 ms move / 200 ms listen).");
    }

    showRandomDanceAnimation();
  }
  // No music: return to idle pose and idle animation.
  else {
    if (dancing) {
      dancing = false;
      restPosition();
      danceStep = 0;
      wasDancing = false;
      listenSampleTaken = false;
    }

    restPosition();
    showIdleEyes();
  }

  wasDancing = dancing;
}
